{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "Provider": "Local",
    "PublicBaseUrl": "/uploads",
    "LocalDirectory": "uploads"
  },
  "Jwt": {
    "Issuer": "klf-api",
    "Audience": "klf-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 8
  }
}
