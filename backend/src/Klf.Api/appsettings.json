{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "Email": {
    "Provider": "Log"
  },
  "TwoFactor": {
    "Required": true
  },
  "Storage": {
    "Provider": "Local",
    "PublicBaseUrl": "/uploads",
    "LocalDirectory": "uploads"
  },
  "Jwt": {
    "Issuer": "klf-api",
    "Audience": "klf-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 8
  }
}
